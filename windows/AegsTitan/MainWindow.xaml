<ui:FluentWindow x:Class="AegsTitan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AEGS Titan" Height="640" Width="440"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Background="#0D1117" Foreground="#F0F6FC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        ResizeMode="CanMinimize">
    
    <ui:FluentWindow.Resources>
        <!-- Clean Subtle Card Style -->
        <Style x:Key="CleanCard" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Margin" Value="4,12,0,6"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Minimal TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="AEGS TITAN" Margin="12,4,12,0"/>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1" Margin="20,10,20,16">

            <!-- ================= VIEW 1: CLEAN BREATHING DASHBOARD ================= -->
            <Grid x:Name="DashboardView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with App Title and Settings Gear -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="AEGS" FontWeight="Bold" FontSize="18" Foreground="#00F2FE" VerticalAlignment="Center"/>
                        <TextBlock Text=" TITAN" FontWeight="Bold" FontSize="18" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                        <Border Background="#1F2937" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v6.5" FontSize="10" Foreground="#9CA3AF"/>
                        </Border>
                    </StackPanel>

                    <!-- Settings Button (Gear) -->
                    <Button x:Name="BtnOpenSettings" Click="BtnOpenSettings_Click" Cursor="Hand" 
                            Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                            Padding="8,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="Настройки" FontSize="12" Foreground="#C9D1D9"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- Center: Prominent Breathing Shield & Connect Button -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Shield Aura Circle -->
                    <Border x:Name="ShieldCircle" Width="130" Height="130" CornerRadius="65" 
                            Background="#111827" BorderBrush="#1F2937" BorderThickness="2"
                            Margin="0,0,0,20">
                        <Button x:Name="BtnConnect" Click="BtnConnect_Click" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Width="126" Height="126">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="ShieldEmoji" Text="🛡️" FontSize="44" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="BtnActionText" Text="СТАРТ" FontWeight="Bold" FontSize="13" Foreground="#00F2FE" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Clean Status Indicators -->
                    <TextBlock x:Name="TxtStatus" Text="Готово к подключению" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#E6EDF3" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSubStatus" Text="TLS 1.3 Reality ECH • 0-RTT" FontSize="12" 
                               Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtSessionTimer" Text="Нажмите щит для старта" FontSize="11" 
                               Foreground="#58A6FF" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Bottom: Minimalist Telemetry Pill Bar (Airy & Uncluttered) -->
                <Border Grid.Row="2" Style="{StaticResource CleanCard}" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Download Speed -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="↓ Входящий" FontSize="10" Foreground="#8B949E" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtRxSpeed" Text="0.0 КБ/с" FontSize="12" FontWeight="Bold" Foreground="#3FB950" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Rectangle Grid.Column="1" Fill="#30363D" Margin="0,2"/>

                        <!-- Upload Speed -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="↑ Исходящий" FontSize="10" Foreground="#8B949E" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtTxSpeed" Text="0.0 КБ/с" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Rectangle Grid.Column="3" Fill="#30363D" Margin="0,2"/>

                        <!-- Ping -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock Text="Задержка" FontSize="10" Foreground="#8B949E" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPing" Text="-- мс" FontSize="12" FontWeight="Bold" Foreground="#A371F7" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= VIEW 2: DEDICATED CLEAN SETTINGS VIEW ================= -->
            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Settings Top Navigation Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <Button x:Name="BtnBackToDashboard" Click="BtnBackToDashboard_Click" Cursor="Hand"
                            Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                            Padding="10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Назад к щиту" FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Настройки" FontWeight="Bold" FontSize="16" Foreground="#F0F6FC" 
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Scrollable Settings Groups -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        
                        <!-- Group: Безопасность -->
                        <TextBlock Text="БЕЗОПАСНОСТЬ И МАСКИРОВКА" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource CleanCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center" Width="240">
                                        <TextBlock Text="Stealth Obfuscation" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC"/>
                                        <TextBlock Text="Маскировка трафика Reality ECH (обход DPI)" FontSize="10" Foreground="#8B949E"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="TglObfuscation" HorizontalAlignment="Right" IsChecked="True"/>
                                </DockPanel>
                                <Separator Background="#21262D" Margin="0,4,0,8"/>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center" Width="240">
                                        <TextBlock Text="Kill Switch" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC"/>
                                        <TextBlock Text="Блокировать сеть при обрыве соединения" FontSize="10" Foreground="#8B949E"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="TglKillSwitch" HorizontalAlignment="Right" IsChecked="True"/>
                                </DockPanel>
                                <Separator Background="#21262D" Margin="0,4,0,8"/>
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center" Width="240">
                                        <TextBlock Text="Умный Split-Routing" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC"/>
                                        <TextBlock Text="Банки, Госуслуги и Ozon идут напрямую" FontSize="10" Foreground="#8B949E"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="TglSplitRouting" HorizontalAlignment="Right" IsChecked="True"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group: Сеть -->
                        <TextBlock Text="ПРОТОКОЛ И СЕРВЕР" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource CleanCard}">
                            <StackPanel>
                                <TextBlock Text="Режим протокола" FontSize="11" Foreground="#8B949E" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbProfile" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" SelectedIndex="0" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Стелс-режим (TLS 1.3 Reality ECH • 443)"/>
                                    <ComboBoxItem Content="Fast Emergency (0-RTT + IAT Shaper)"/>
                                    <ComboBoxItem Content="Turbo PQC (Direct Quantum UDP)"/>
                                </ComboBox>

                                <TextBlock Text="Защищенный DNS" FontSize="11" Foreground="#8B949E" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbDns" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" SelectedIndex="0">
                                    <ComboBoxItem Content="Cloudflare DoH (1.1.1.1)"/>
                                    <ComboBoxItem Content="AdGuard DNS (Анти-реклама)"/>
                                    <ComboBoxItem Content="Системный DNS по умолчанию"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Group: Автозапуск -->
                        <TextBlock Text="АВТОМАТИЗАЦИЯ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource CleanCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Запуск вместе с Windows" FontSize="12" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch x:Name="TglStartup" HorizontalAlignment="Right" IsChecked="False"/>
                                </DockPanel>
                                <Separator Background="#21262D" Margin="0,4,0,8"/>
                                <DockPanel>
                                    <TextBlock Text="Автоподключение при старте" FontSize="12" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch x:Name="TglAutoConnect" HorizontalAlignment="Right" IsChecked="False"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Key Box -->
                        <TextBlock Text="КЛЮЧ ДОСТУПА" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource CleanCard}">
                            <TextBox x:Name="TxtToken" Background="#0D1117" Foreground="#58A6FF" BorderBrush="#30363D" 
                                     Padding="8,6" FontSize="11" Text="" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- Bottom Footer (Very Subtle Ticker) -->
        <Border Grid.Row="2" Background="#090D13" BorderBrush="#21262D" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <Ellipse Width="6" Height="6" Fill="#3FB950" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtLogTicker" Text="AEGS Ready. Нажмите щит для старта." 
                           Foreground="#8B949E" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtFooterServer" Text="AEGS v6 Titan" Foreground="#484F58" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
