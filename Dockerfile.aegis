# syntax=docker/dockerfile:1
# =============================================================================
# AEGS Protocol v5 "Pantheon" Global Edition - Production Dockerfile
# Base: Alpine Linux 3.20 (musl libc, hardened security, unprivileged execution)
# =============================================================================

# Stage 1: Build & Compile
FROM alpine:3.20 AS builder

RUN apk add --no-cache \
    build-base \
    cmake \
    pkgconf \
    openssl-dev \
    sqlite-dev \
    linux-headers

WORKDIR /build

COPY . .

RUN cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS="-O3 -Wall -Wextra -fstack-protector-strong -D_FORTIFY_SOURCE=2" \
    && cmake --build build -j"$(nproc)" --target aegs_server \
    && strip build/aegs_server

# Stage 2: Minimal Hardened Runtime
FROM alpine:3.20

LABEL org.opencontainers.image.title="AEGS Protocol v5 Global Server" \
      org.opencontainers.image.description="Carrier-grade, sharded, multi-core UDP tunnel protocol" \
      org.opencontainers.image.version="5.0.0" \
      org.opencontainers.image.authors="AEGS Protocol Team" \
      org.opencontainers.image.licenses="MIT"

RUN apk add --no-cache \
    libcrypto3 \
    libssl3 \
    sqlite-libs \
    libstdc++ \
    libgcc \
    ca-certificates \
    tzdata \
    && addgroup -g 10001 -S aegs \
    && adduser -u 10001 -S -G aegs -s /sbin/nologin -D -H aegs \
    && mkdir -p /app/data \
    && chown -R aegs:aegs /app \
    && chmod 755 /app /app/data

WORKDIR /app

COPY --from=builder --chown=aegs:aegs /build/build/aegs_server /app/aegs_server

USER aegs:aegs

EXPOSE 50001/udp
VOLUME ["/app/data"]

ENTRYPOINT ["/app/aegs_server"]
