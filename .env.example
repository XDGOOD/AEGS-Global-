# =============================================================================
# AEGS Protocol v2 & WireGuard Environment Configuration Template
# =============================================================================

# Server Public Host / IP for WireGuard Server URL
SERVERURL=auto

# Obfuscated AEGS v2 Public Entrypoint Port (UDP)
AEGS_PORT=50001

# WireGuard Internal Port (UDP) - Kept inside Docker aegis-net
WG_PORT=51820

# Timezone & User Permissions for LinuxServer WireGuard container
TZ=Etc/UTC
PUID=1000
PGID=1000

# WireGuard Peer Configuration
PEERS=1
PEERDNS=auto
INTERNAL_SUBNET=10.13.13.0
ALLOWEDIPS=0.0.0.0/0

# =============================================================================
# AEGS v4 "Pantheon" -- Component 3: DPI bypass
# =============================================================================

# Port hopping: number of consecutive ports the server binds simultaneously.
# Range [1..64]. Client predicts the active port via HMAC-SHA256(session_key, epoch).
AEGS_PORT_COUNT=10

# Port hopping: rotation period in seconds. Lower = harder to DPI, higher latency.
AEGS_HOP_INTERVAL=30

# QUIC Initial packet mimicry: set to 1 to prepend an 8-byte fake QUIC header
# to every outbound UDP packet. Fools stateless DPI that classifies by first byte.
AEGS_QUIC_MIMICRY=0

# Traffic shaping jitter: set to 1 to add a random send delay before each packet.
# Breaks packet-timing fingerprints. Adds up to AEGS_JITTER_MS ms of latency.
AEGS_TRAFFIC_SHAPING=0

# Maximum jitter in milliseconds when AEGS_TRAFFIC_SHAPING=1. Range [0..1000].
AEGS_JITTER_MS=5
