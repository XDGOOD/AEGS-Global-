<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D10">

    <!-- Ambient Floating Translucent Amber Circles -->
    <com.aegs.titan.WaveCirclesBackgroundView
        android:id="@+id/bg_wave_circles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Top Header Navigation -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AEGS"
                    android:textColor="#FFFBEB"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TITAN"
                    android:textColor="#F59E0B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#1FF59E0B"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Пропустить"
                android:textColor="#A8A29E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="6dp" />
        </RelativeLayout>

        <!-- Central Animation Viewport -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <com.aegs.titan.AnimShieldSpeedometerView
                android:id="@+id/anim_view"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center" />

            <!-- Source Choice Cards Container (Shown on Step 3) -->
            <LinearLayout
                android:id="@+id/ll_source_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/card_source_cloud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_obsidian"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AEGS Cloud (Кластер)"
                        android:textColor="#FFFBEB"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Автоматический выбор оптимального высокоскоростного сервера."
                        android:textColor="#A8A29E"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_source_vps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_obsidian"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Личный сервер VPS"
                        android:textColor="#FFFBEB"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Подключение по IP адресу, порту и персональному токену."
                        android:textColor="#A8A29E"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Title & Subtitle Descriptions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Добро пожаловать в AEGS"
                android:textColor="#FFFBEB"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Свободный и безопасный интернет без цензуры, слежки и замедлений провайдера."
                android:textColor="#A8A29E"
                android:textSize="13.5sp"
                android:lineSpacingExtra="3dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Dots Step Indicator (4 steps) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <View
                android:id="@+id/dot_0"
                android:layout_width="24dp"
                android:layout_height="6dp"
                android:background="#F59E0B"
                android:layout_marginEnd="6dp" />

            <View
                android:id="@+id/dot_1"
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:background="#2E2820"
                android:layout_marginEnd="6dp" />

            <View
                android:id="@+id/dot_2"
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:background="#2E2820"
                android:layout_marginEnd="6dp" />

            <View
                android:id="@+id/dot_3"
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:background="#2E2820" />
        </LinearLayout>

        <!-- Warm Amber Action Button -->
        <Button
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ДАЛЕЕ"
            android:textColor="#261102"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_amber_gradient"
            android:layout_marginBottom="6dp" />

    </LinearLayout>
</FrameLayout>
