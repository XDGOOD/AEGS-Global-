<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1117"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Skip / Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AEGS VPN"
            android:textColor="#2563EB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Пропустить"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:padding="4dp" />
    </RelativeLayout>

    <!-- Animated Canvas View Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <com.aegs.titan.AnimShieldSpeedometerView
            android:id="@+id/anim_view"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Text Descriptions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добро пожаловать в AEGS"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Свободный, безопасный интернет без цензуры, слежки и ограничений скорости."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Dots Step Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <View
            android:id="@+id/dot_0"
            android:layout_width="24dp"
            android:layout_height="6dp"
            android:background="#2563EB"
            android:layout_marginEnd="6dp" />

        <View
            android:id="@+id/dot_1"
            android:layout_width="8dp"
            android:layout_height="6dp"
            android:background="#1E293B"
            android:layout_marginEnd="6dp" />

        <View
            android:id="@+id/dot_2"
            android:layout_width="8dp"
            android:layout_height="6dp"
            android:background="#1E293B" />
    </LinearLayout>

    <!-- Next / Finish Button -->
    <Button
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ДАЛЕЕ  →"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#2563EB"
        android:layout_marginBottom="8dp" />

</LinearLayout>
