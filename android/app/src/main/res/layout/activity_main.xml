<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D10">

    <!-- Ambient Floating Translucent Amber Circles -->
    <com.aegs.titan.WaveCirclesBackgroundView
        android:id="@+id/bg_wave_circles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- Top Header Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/app_icon"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AEGS VPN"
                                android:textColor="#FFFBEB"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TITAN"
                                android:textColor="#F59E0B"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="#1FF59E0B"
                                android:paddingLeft="6dp"
                                android:paddingRight="6dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_proto_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="v6.5 • Chrome 128+ Reality ECH"
                            android:textColor="#F59E0B"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_guide"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Гайд"
                        android:textColor="#F59E0B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/card_obsidian"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/btn_settings"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_settings"
                        android:background="@drawable/card_obsidian"
                        android:padding="8dp"
                        android:tint="#B3FFB300"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Настройки" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Status Pill Badge -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="● Отключено • Готов к защите"
                android:textColor="#F87171"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:background="#1C1917"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Big Circular Connect Button -->
            <LinearLayout
                android:id="@+id/btn_connect_circle"
                android:layout_width="152dp"
                android:layout_height="152dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/btn_connect_circle"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tv_conn_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ПОДКЛЮЧИТЬ"
                    android:textColor="#FFFBEB"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_conn_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Готов?"
                    android:textColor="#F59E0B"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Telemetry & Live Bezier Metrics Graph Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_obsidian"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ТЕЛЕМЕТРИЯ КАНАЛА"
                        android:textColor="#A8A29E"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tv_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="LTO TURBO 940 Мбит/с"
                        android:textColor="#F59E0B"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tv_ping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Пинг до сервера: -- мс"
                    android:textColor="#FFFBEB"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

                <!-- Live Obsidian & Amber Bezier Latency / Jitter Graph -->
                <com.aegs.titan.LiveMetricsGraphView
                    android:id="@+id/metrics_graph"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Split Tunneling Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_obsidian"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <CheckBox
                    android:id="@+id/cb_split"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Умный обход (Split-Tunneling)"
                    android:textColor="#F59E0B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:checked="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Банки РФ (Сбер, Т-Банк, ВТБ, Альфа), Госуслуги, Ozon, WB работают напрямую без капчи."
                    android:textColor="#A8A29E"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Mode Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="РЕЖИМ ПОДКЛЮЧЕНИЯ"
                android:textColor="#A8A29E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rg_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rb_service"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Кластер AEGS"
                    android:textColor="#FFFBEB"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rb_custom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Свой VPS"
                    android:textColor="#FFFBEB" />
            </RadioGroup>

            <!-- Custom VPS inputs -->
            <LinearLayout
                android:id="@+id/ll_custom_vps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="14dp">

                <EditText
                    android:id="@+id/et_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="IP адрес VPS сервера"
                    android:textColor="#FFFBEB"
                    android:textColorHint="#71717A"
                    android:background="@drawable/card_obsidian"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Порт (по умолчанию 50001)"
                    android:text="50001"
                    android:textColor="#FFFBEB"
                    android:textColorHint="#71717A"
                    android:background="@drawable/card_obsidian"
                    android:padding="12dp"
                    android:inputType="number"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Секретный токен (Ключ)"
                    android:textColor="#FFFBEB"
                    android:textColorHint="#71717A"
                    android:background="@drawable/card_obsidian"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- Prominent Settings Section Card (Unmissable!) -->
            <LinearLayout
                android:id="@+id/card_open_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_obsidian"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_settings"
                    android:background="@drawable/btn_connect_circle"
                    android:tint="#F59E0B"
                    android:alpha="0.9"
                    android:padding="9dp"
                    android:contentDescription="Настройки" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️ Раздел с настройками"
                        android:textColor="#FFFBEB"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reality ECH, Kill-Switch, Режимы обхода, Авторы"
                        android:textColor="#A8A29E"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➔"
                    android:textColor="#F59E0B"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
