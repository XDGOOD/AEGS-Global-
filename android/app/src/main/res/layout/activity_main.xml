<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12141A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AEGS TITAN"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v6.5 • RFC 9000 QUIC Stealth"
            android:textColor="#00D26A"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1F2C"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Отключено"
                android:textColor="#F87171"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Пинг: -- мс"
                android:textColor="#8E99B0"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Split Tunneling Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1F2C"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/cb_split"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Умный обход (Split-Tunneling)"
                android:textColor="#00D26A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:checked="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Банки (Сбер, Т-Банк, ВТБ), Госуслуги и российские сервисы работают напрямую без капчи."
                android:textColor="#8E99B0"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Mode selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="РЕЖИМ ПОДКЛЮЧЕНИЯ"
            android:textColor="#8E99B0"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_service"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Наш Сервис"
                android:textColor="#FFFFFF"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_custom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Свой VPS"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <!-- Custom VPS inputs -->
        <LinearLayout
            android:id="@+id/ll_custom_vps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/et_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="IP адрес VPS сервера"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E99B0"
                android:background="#1A1F2C"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Порт (по умолчанию 50001)"
                android:text="50001"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E99B0"
                android:background="#1A1F2C"
                android:padding="12dp"
                android:inputType="number"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Секретный токен"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E99B0"
                android:background="#1A1F2C"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Connect Button -->
        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ПОДКЛЮЧИТЬСЯ"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#0D6EFD"
            android:layout_marginBottom="20dp" />

        <!-- Protocol Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1F2C"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Маскировка: RFC 9000 QUIC Initial (Anti-DPI)"
                android:textColor="#8E99B0"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Защита: ChaCha20-Poly1305 + Stateless Cookies"
                android:textColor="#8E99B0"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Скорость: До 900+ Мбит/с с аппаратным ускорением"
                android:textColor="#8E99B0"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
