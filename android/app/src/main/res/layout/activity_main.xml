<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Header with Icon & Title & Guide Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/app_icon"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AEGS VPN"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v6.0 Titan • RFC 9000 QUIC Stealth"
                        android:textColor="#10B981"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_guide"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="✨ Гид"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:background="#191D28" />
        </RelativeLayout>

        <!-- Status & Telemetry Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#191D28"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Отключено"
                    android:textColor="#EF4444"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Лимит: 940 Мбит/с"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Пинг: -- мс"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Split Tunneling Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#191D28"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/cb_split"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Умный обход (Split-Tunneling)"
                android:textColor="#10B981"
                android:textSize="14sp"
                android:textStyle="bold"
                android:checked="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Банки (Сбер, Т-Банк, ВТБ), Госуслуги, Ozon, WB работают напрямую без капчи и замедлений."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Connection Mode selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="РЕЖИМ ПОДКЛЮЧЕНИЯ"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_service"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Кластер AEGS"
                android:textColor="#FFFFFF"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_custom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Свой VPS"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <!-- Custom VPS inputs -->
        <LinearLayout
            android:id="@+id/ll_custom_vps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/et_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="IP адрес VPS сервера"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:background="#191D28"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Порт (по умолчанию 50001)"
                android:text="50001"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:background="#191D28"
                android:padding="12dp"
                android:inputType="number"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Секретный токен (Ключ)"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:background="#191D28"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Connect Button -->
        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ПОДКЛЮЧИТЬСЯ"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#2563EB"
            android:layout_marginBottom="20dp" />

        <!-- Protocol & Project Links Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#191D28"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПРОЕКТ И РАЗРАБОТЧИКИ"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_github_core"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="Ядро протокола: net-packet-handler"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:background="#232936"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_github_global"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="Кластер и инфраструктура: AEGS-Global-"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:background="#232936"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_author"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="Автор и разработчик: XDGOOD"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:background="#232936" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
